{
  "name": "next-middleware-toolkit",
  "version": "2.0.0",
  "description": "A simple, type-safe middleware system for Next.js with route protection and built-in authentication rules",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chaqchase/next-middleware.git"
  },
  "bugs": {
    "url": "https://github.com/chaqchase/next-middleware/issues"
  },
  "homepage": "https://github.com/chaqchase/next-middleware",
  "author": {
    "name": "Mohamed Achaq",
    "email": "hi@chaqchase.com",
    "url": "https://chaqchase.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --clean",
    "dev": "tsup src/index.ts --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm type-check && pnpm format:check && pnpm test",
    "prepublishOnly": "pnpm validate && pnpm build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "version": "changeset version"
  },
  "module": "dist/index.js",
  "main": "dist/index.cjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@vitest/ui": "^3.2.4",
    "next": "^15.4.7",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "next",
    "next.js",
    "nextjs",
    "middleware",
    "auth",
    "authentication",
    "authorization",
    "route-protection",
    "protected-routes",
    "next-middleware",
    "typescript",
    "type-safe",
    "rbac",
    "permissions"
  ]
}
